+        onPhase: (text) => { if (!controller.signal.aborted) setPhaseText(text); },
+      });
+      if (controller.signal.aborted) return;
+      setJob(result);
+      setPhase("processing");
+      setPhaseText("업로드 완료 · 분류 작업 상태를 확인하고 있어요.");
