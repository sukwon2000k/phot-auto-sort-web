+        """사용자에게 필요한 상태만 반환하고 서버 파일 경로는 공개하지 않습니다."""
+        return {
+            "id": self.id, "status": self.status, "counts": self.counts,
+            "failed_count": self.failed_count, "error": self.error,
+            "expires_at": self.expires_at,
+            "progress": self.progress,
