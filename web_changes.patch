+    onNew={() => { setFiles([]); setPage(0); setNotice(""); setError(""); setPhase("idle"); navigate("/"); }}
+    previewItems={visible.map((item) => <PreviewItem key={item.id} item={item} disabled={busy} onRemove={removeFile} />)} />;
+}
