# 원본 압축파일 제외
*.zip

# 개인 VS Code 설정 제외
/.vscode/

# 파이썬 임시파일과 가상환경 제외
__pycache__/
*.pyc
.venv/
venv/

# 학습 모델 파일 제외
*.pth
*.pt
*.onnx

# 비밀값과 사용자 업로드·결과·서버 작업 파일 제외
.env
.env.*
!.env.example
.work/
outputs/
uploads/
results/
*.pem
*.key
*.log
.pytest_cache/
*.egg-info/

# React 의존성과 빌드 결과는 소스 관리에서 제외합니다.
node_modules/
frontend/dist/
